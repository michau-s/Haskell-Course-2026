cabal-version:      2.4
name:               UiLayoutLang
version:            0.1.0.0
synopsis:           Declarative UI Layout Engine (Course Project)

executable UiLayoutLang
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    Types,
                      Parser,
                      Layout,
                      Render
    
    build-depends:    base >= 4.14 && < 5,
                      megaparsec >= 9.0
                      
    default-language: Haskell2010

test-suite UiLayoutLang-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test, src
    other-modules:    Types, Layout, Parser, Render
    build-depends:    base >= 4.14 && < 5,
                      megaparsec >= 9.0,
                      QuickCheck >= 2.14,
                      hspec >= 2.7
    default-language: Haskell2010